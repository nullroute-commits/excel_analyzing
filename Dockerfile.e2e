# E2E Test Dockerfile - Debian-based for Playwright compatibility
FROM mcr.microsoft.com/playwright/python:v1.48.0-jammy AS base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=test \
    DJANGO_DEBUG=False \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_EXCEL_ANALYZING=0.1.0

# Set work directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt requirements-e2e.txt ./
RUN pip install --no-cache-dir -r requirements-e2e.txt

# Copy project
COPY . .

# Install the package
RUN pip install -e .

# Create directories
RUN mkdir -p /app/logs /app/staticfiles && \
    chown -R pwuser:pwuser /app

# Install Playwright browsers (they're already installed in the base image)
RUN playwright install chromium

# Switch to non-root user
USER pwuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

# Expose port
EXPOSE 8000

# Run E2E tests by default
CMD ["python", "-m", "pytest", "tests/e2e/", "-v", "--headed"]
