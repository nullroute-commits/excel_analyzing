# Test Dockerfile - Optimized for testing environment
FROM python:3.12-alpine AS base

# Install system dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    postgresql-dev \
    libffi-dev \
    curl \
    git \
    && rm -rf /var/cache/apk/*

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=test \
    DJANGO_DEBUG=False \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_EXCEL_ANALYZING=0.1.0

# Create non-root user
RUN addgroup -g 1000 excel && \
    adduser -u 1000 -G excel -s /bin/sh -D excel

# Set work directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements-dev.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# Copy project
COPY . .

# Install the package
RUN pip install -e .

# Create directories and fix permissions
RUN mkdir -p /app/logs /app/staticfiles /app/.pytest_cache && \
    chown -R excel:excel /app && \
    chmod -R 755 /app

# Switch to non-root user
USER excel

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

# Expose port
EXPOSE 8000

# Run tests by default, can be overridden
CMD ["python", "-m", "pytest", "-v"]