# Django Web Service - Production Environment
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
DJANGO_ALLOWED_HOSTS=prod-web-service,excel-analyzing.com,api.excel-analyzing.com
DJANGO_CORS_ALLOW_ALL_ORIGINS=False

# Database connectivity
DATABASE_HOST=prod-db-service
DATABASE_PORT=5432
DATABASE_NAME=excel_analyzing_prod
DATABASE_USER=postgres
DATABASE_PASSWORD=${DATABASE_PASSWORD}

# Cache connectivity (Database-based for NIST compliance)
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=cache_table
CACHE_TIMEOUT=600

# Application URLs
API_BASE_URL=https://api.excel-analyzing.com/api
FRONTEND_URL=https://excel-analyzing.com

# Security
CSRF_TRUSTED_ORIGINS=https://excel-analyzing.com,https://api.excel-analyzing.com