# Django Web Service - Development Environment
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=web-service,dev-web-service
DJANGO_CORS_ALLOW_ALL_ORIGINS=True

# Database connectivity
DATABASE_HOST=db-service
DATABASE_PORT=5432
DATABASE_NAME=excel_analyzing_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# Cache connectivity (Database-based for NIST compliance)
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=cache_table
CACHE_TIMEOUT=300

# Application URLs
API_BASE_URL=http://web-service:8000/api
FRONTEND_URL=http://web-service:8000

# Security
CSRF_TRUSTED_ORIGINS=http://web-service:8000,http://dev-web-service:8000