# Django Web Service - Test Environment
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=test-secret-key-for-testing-only-this-is-long-enough-for-security-tests
DJANGO_ALLOWED_HOSTS=test-web-service,web-service
DJANGO_CORS_ALLOW_ALL_ORIGINS=False

# Database connectivity
DATABASE_HOST=test-db-service
DATABASE_PORT=5432
DATABASE_NAME=excel_analyzing_test
DATABASE_USER=postgres
DATABASE_PASSWORD=test_password

# Cache connectivity (Database-based for NIST compliance)
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=cache_table_test
CACHE_TIMEOUT=120

# Application URLs
API_BASE_URL=http://test-web-service:8000/api
FRONTEND_URL=http://test-web-service:8000

# Security
CSRF_TRUSTED_ORIGINS=http://test-web-service:8000